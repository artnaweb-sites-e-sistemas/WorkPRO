{
  "manifest_version": 3,
  "name": "WorkPRO Cold call",
  "version": "1.0.0",
  "description": "Mostra no Google Maps e no Google Locais quem você já ligou, e manda a empresa para o Cold call do WorkPRO com um clique.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.br/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com.br/maps/*",
        "https://www.google.com/search*",
        "https://www.google.com.br/search*"
      ],
      "js": ["shared.js", "google.js"],
      "css": ["google.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
